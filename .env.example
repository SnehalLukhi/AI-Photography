# Optional: where the frontend finds the backend (defaults to http://localhost:5001)
VITE_API_BASE_URL=http://localhost:5001
# "Continue with Google": the same OAuth client id as GOOGLE_CLIENT_ID in backend/.env (Google Cloud Console > Credentials, Web application)
VITE_GOOGLE_CLIENT_ID=
# "Continue with Apple": the same Services ID as APPLE_CLIENT_ID in backend/.env (Apple Developer > Identifiers > Services IDs)
VITE_APPLE_CLIENT_ID=
# The Return URL registered for that Services ID, e.g. https://www.yourdomain.com (exactly as registered; https only). Empty = the address the site is opened on.
VITE_APPLE_REDIRECT_URI=
