# Copy this file to ".env" and fill in your real values. NEVER commit ".env".

# --- Server ---
PORT=5001
NODE_ENV=development
# Comma-separated list of frontend origins allowed to call this API (CORS)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- AILabTools (https://www.ailabtools.com) ---
# Get a key: https://www.ailabtools.com/docs/get-api-key
AILAB_API_KEY=

# --- Accounts (sign in with Google) ---
# Long random string used to sign login tokens, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED in production (NODE_ENV=production); without it logins are disabled there. Changing it logs everyone out.
JWT_SECRET=
# Database (Supabase / PostgreSQL): users, coin balances, generations. REQUIRED - the server will not start without it.
# Supabase dashboard > Project Settings > Database > Connection string > "Session pooler" (or "Transaction pooler"), with your database password filled in.
# Use the pooler string (not "Direct connection": that one is IPv6-only). Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# "Continue with Google": OAuth client id (type: Web application) from Google Cloud Console > APIs & Services > Credentials.
# Add your site (e.g. http://localhost:5173) under "Authorized JavaScript origins". Use the same id as VITE_GOOGLE_CLIENT_ID in the frontend .env.
GOOGLE_CLIENT_ID=
# "Continue with Apple": the Services ID (e.g. com.yourcompany.pixora.web) from Apple Developer > Certificates, Identifiers & Profiles > Identifiers > Services IDs.
# Enable "Sign in with Apple" for it and add your domain and the Return URL (see VITE_APPLE_REDIRECT_URI in the frontend .env). Same value as VITE_APPLE_CLIENT_ID.
# Apple only allows https domains: it cannot be tested on http://localhost (use your deployed site or an https tunnel).
APPLE_CLIENT_ID=
# DAILY_GENERATION_LIMIT=100
# Secret for the admin endpoints (/api/admin/trending, /api/admin/templates, /api/admin/template-categories), sent as header x-admin-key. Leave empty to switch them off. Use a long random string.
# Admin dashboard. Admins are created with the API (POST /api/admin/admins) and sign in with a user name and password.
# ADMIN_API_KEY is the secret you use (header x-admin-key) to create the FIRST admin; after that the dashboard needs only user names and passwords.
# Picsart API Platform key (AI video models), used by the admin dashboard's Video lab. Get one at https://picsart.com/api-platform
# PICSART_API_KEY=
# PICSART_API_URL=https://api.picsart.com
# Viggle (copies the motion of a reference video onto a picture): admin Video lab, "Video + picture"
# VIGGLE_API_KEY=
# VIGGLE_API_URL=https://apis.viggle.ai/v1
# ADMIN_API_KEY=
# Prices are converted from dollars to the visitor's currency (rupees, euros, pounds, ...) and rounded up to x99. The rate is fetched once a day; pin one with e.g. FX_RATES={"INR":94}
# FX_RATES=
# Optional: one extra admin straight from the environment (no API call needed).
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_TOKEN_HOURS=12
# Optional: what the image provider charges you per finished call (US dollars), only to show an estimated spend in the admin dashboard.
# AILAB_COST_PER_CALL=0.03
# COIN_COST_PER_GENERATION=150
# SIGNUP_BONUS_COINS=100
# TOKEN_TTL_SECONDS=604800
# AUTH_RATE_LIMIT_MAX=20

# --- Razorpay (payments for coin packs and plans) ---
# Razorpay Dashboard > Account & Settings > API Keys. Prices are in US dollars, so International Payments / USD must be enabled on the account.
# Name shown at the top of Razorpay's payment window (default Pictrify)
# BRAND_NAME=Pictrify
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Account & Settings > Webhooks > Add: URL https://<your-domain>/api/webhooks/razorpay, events payment.captured and order.paid,
# and a secret of your choice (put the same value here). The webhook credits coins when a customer pays but closes the tab before the page confirms it.
RAZORPAY_WEBHOOK_SECRET=
# Auto-renewing plans: Razorpay Dashboard > Subscriptions > Plans. Put the plan ids here (plan_xxx); the plan's price and period must match the site (Weekly $4.99, Monthly $9.99, Yearly $39.99).
# A plan without an id here is sold as a one-time purchase. For subscriptions also add these webhook events: subscription.charged, subscription.activated, subscription.cancelled, subscription.completed, subscription.halted, subscription.pending.
RAZORPAY_PLAN_WEEKLY=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
# OPTIONAL. Visitors in India pay rupees (Weekly 399, Monthly 799, Yearly 3999 from src/config/plans.js). Their Razorpay plans are found - or created once - automatically,
# so leave these empty. Set one only to force a specific existing plan.
RAZORPAY_PLAN_WEEKLY_INR=
RAZORPAY_PLAN_MONTHLY_INR=
RAZORPAY_PLAN_YEARLY_INR=
# Visitors in India pay in rupees, everyone else in dollars (country from the host, e.g. Vercel). Local development has no country: set DEFAULT_CURRENCY=INR to try the rupee prices.
# DEFAULT_CURRENCY=USD
# Optional: a cheap rupee plan (₹9.99 / month in INR, 15 coins; the price must match the Razorpay plan) for testing payments. Create it in Razorpay (test mode) and put its id here; remove the line to hide the "Test Plan" card.
# RAZORPAY_PLAN_TEST=
# The first-login popup discounts the Yearly plan. For an auto-renewing plan the discount is a Razorpay Offer: create a 50% Offer (Dashboard > Subscriptions > Offers) and put its id (offer_xxx) here.
RAZORPAY_OFFER_YEARLY=

# --- DigitalOcean Spaces (stores the original photo + the AI result) ---
# Create a Space and a key pair with Read/Write/Delete permission: DigitalOcean > API > Spaces Keys. Storage is skipped while these are empty.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=nyc3
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# SPACES_PREFIX=ai-photography
# Base address of the public image URLs. Default: the Space's own address (https://<bucket>.<region>.digitaloceanspaces.com).
# If you enabled the Space's CDN, set its address here (https://<bucket>.<region>.cdn.digitaloceanspaces.com).
# SPACES_PUBLIC_URL=

# --- Optional tuning (defaults shown) ---
# AILAB_BASE_URL=https://www.ailabapi.com
# AILAB_REQUEST_TIMEOUT_MS=90000
# AILAB_POLL_INTERVAL_MS=5000
# AILAB_POLL_TIMEOUT_MS=120000
# MAX_UPLOAD_MB=10
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=10
