# Copy this file to ".env" and fill in your real values. NEVER commit ".env".

# --- Server ---
PORT=5001
NODE_ENV=development
# Comma-separated list of frontend origins allowed to call this API (CORS)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- AILabTools (https://www.ailabtools.com) ---
# Get a key: https://www.ailabtools.com/docs/get-api-key
AILAB_API_KEY=

# --- Accounts (sign in with Google) ---
# Long random string used to sign login tokens, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED in production (NODE_ENV=production); without it logins are disabled there. Changing it logs everyone out.
JWT_SECRET=
# Database (Supabase / PostgreSQL): users, coin balances, generations. REQUIRED - the server will not start without it.
# Supabase dashboard > Project Settings > Database > Connection string > "Session pooler" (or "Transaction pooler"), with your database password filled in.
# Use the pooler string (not "Direct connection": that one is IPv6-only). Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# "Continue with Google": OAuth client id (type: Web application) from Google Cloud Console > APIs & Services > Credentials.
# Add your site (e.g. http://localhost:5173) under "Authorized JavaScript origins". Use the same id as VITE_GOOGLE_CLIENT_ID in the frontend .env.
GOOGLE_CLIENT_ID=
# DAILY_GENERATION_LIMIT=100
# COIN_COST_PER_GENERATION=15
# SIGNUP_BONUS_COINS=50
# TOKEN_TTL_SECONDS=604800
# AUTH_RATE_LIMIT_MAX=20

# --- DigitalOcean Spaces (stores the original photo + the AI result) ---
# Create a Space and a key pair with Read/Write/Delete permission: DigitalOcean > API > Spaces Keys. Storage is skipped while these are empty.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=nyc3
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# SPACES_PREFIX=ai-photography
# Base address of the public image URLs. Default: the Space's own address (https://<bucket>.<region>.digitaloceanspaces.com).
# If you enabled the Space's CDN, set its address here (https://<bucket>.<region>.cdn.digitaloceanspaces.com).
# SPACES_PUBLIC_URL=

# --- Optional tuning (defaults shown) ---
# AILAB_BASE_URL=https://www.ailabapi.com
# AILAB_REQUEST_TIMEOUT_MS=90000
# AILAB_POLL_INTERVAL_MS=5000
# AILAB_POLL_TIMEOUT_MS=120000
# MAX_UPLOAD_MB=10
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=10
